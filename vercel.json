{
  "crons": [
    {
      "path": "/api/cron/refresh-lemlist",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/sync-meetings",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/sync-meetings?sinceDays=45",
      "schedule": "0 11-23 * * 1-5"
    },
    {
      "path": "/api/cron/analyze-allo-calls",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/celulas-sdr-alerts",
      "schedule": "30 11 * * 1-5"
    },
    {
      "path": "/api/cron/wishlist-contacts",
      "schedule": "*/15 * * * *"
    }
  ],
  "framework": "nextjs",
  "buildCommand": "next build",
  "functions": {
    "app/api/cron/wishlist-contacts/route.ts": { "maxDuration": 300 },
    "app/api/portal-admin/wishlist-contacts/route.ts": { "maxDuration": 60 },
    "app/api/lemlist/csv-generate/route.ts": { "maxDuration": 60 },
    "app/api/contacts/[id]/preview-messages/route.ts": { "maxDuration": 60 },
    "app/api/companies/[id]/deep-research/route.ts": { "maxDuration": 60 },
    "app/api/companies/research-one/route.ts": { "maxDuration": 60 },
    "app/api/training/lab/route.ts": { "maxDuration": 60 },
    "app/api/analisis/salud-telefonica/route.ts": { "maxDuration": 90 },
    "app/api/analisis/horarios/route.ts": { "maxDuration": 60 },
    "app/api/analisis/actividades-hubspot/route.ts": { "maxDuration": 90 },
    "app/api/analisis/sdr/route.ts": { "maxDuration": 60 },
    "app/api/analisis/paises/route.ts": { "maxDuration": 60 },
    "app/api/analisis/clientes/route.ts": { "maxDuration": 60 },
    "app/api/clients/[id]/allo-calls/route.ts": { "maxDuration": 60 },
    "app/api/analisis/scores/route.ts": { "maxDuration": 60 },
    "app/api/celulas-sdr/base/route.ts": { "maxDuration": 60 },
    "app/api/celulas-sdr/allo/route.ts": { "maxDuration": 300 },
    "app/api/celulas-sdr/hubspot/route.ts": { "maxDuration": 300 },
    "app/api/cron/celulas-sdr-alerts/route.ts": { "maxDuration": 300 },
    "app/api/celulas-sdr/alerts-preview/route.ts": { "maxDuration": 300 }
  }
}
