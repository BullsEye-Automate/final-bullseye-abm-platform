# Connection string de Postgres (Supabase → Project Settings → Database → Connection string → URI)
# Usa la conexión "Session pooler" o la directa; ambas funcionan para este esqueleto.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Puerto local del backend (opcional, default 3001)
PORT=3001

# Google Cloud Console → tu proyecto → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Debe coincidir EXACTO con un "Authorized redirect URI" del OAuth client de arriba.
# En local, usa la URL pública de tu túnel (ngrok, etc.) + /auth/google/callback
GOOGLE_REDIRECT_URI=https://tu-url-publica.ngrok-free.app/auth/google/callback

# URL pública base del backend (sin path). Google Calendar necesita mandarte
# el webhook a una URL HTTPS pública — en local, la de tu túnel (ngrok, etc.)
PUBLIC_BASE_URL=https://tu-url-publica.ngrok-free.app

# Deepgram (deepgram.com → API Keys) — transcripción del audio de las reuniones
DEEPGRAM_API_KEY=

# Anthropic (console.anthropic.com → API Keys) — análisis post-reunión con Claude
ANTHROPIC_API_KEY=

# Excel de metas (Google Sheets) — trae nombre/cargo/industria del contacto y
# el cliente de BullsEye de cada reunión agendada.
# METAS_SHEET_ID: el ID del spreadsheet (está en la URL de Google Sheets,
#   entre /d/ y /edit).
# METAS_SHEET_GOOGLE_ACCOUNT_EMAIL: el email de la cuenta de Google ya
#   conectada en /auth/google (debe tener acceso de lectura a ese excel, y
#   haber vuelto a pasar por /auth/google después de agregar el scope de
#   Sheets — ver google.ts).
METAS_SHEET_ID=
METAS_SHEET_GOOGLE_ACCOUNT_EMAIL=

# Base de conocimiento (Módulo 3) — Supabase Storage guarda los archivos
# subidos por cliente (ICP, propuesta de valor, casos de éxito, etc.).
# SUPABASE_URL: Supabase Studio del proyecto "peitho" → Project Settings → API → Project URL.
# SUPABASE_SERVICE_ROLE_KEY: misma pantalla → "service_role" key (secreta,
#   nunca la subas a git ni la uses en el frontend — tiene acceso total).
# Antes de usar esto hay que crear el bucket "knowledge-base" en Supabase
# Studio → Storage → New bucket (privado, no público).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Recall.ai (Fase H) — bot "Peitho" que se une a las reuniones y las graba,
# reemplazando la extensión de Chrome. Dashboard de Recall → API Keys.
RECALL_API_KEY=

# La API de Recall es específica por región — tiene que ser la misma región
# donde está tu cuenta/dashboard (ej. "us-west-2", "us-east-1", "eu-central-1").
# Se arma la URL base como https://{region}.recall.ai/api/v2/...
RECALL_REGION=us-west-2

# Dashboard de Recall → pestaña "Google Meet Credentials" → crea el login con
# una cuenta de Gmail dedicada (nombre "Peitho", recovery email/phone
# configurados, idioma inglés US — si falta alguno el bot falla con
# BOT_SIGN_IN_FAILED) y agrúpalo en un login group. Este es el ID de ese grupo,
# no el de la cuenta individual.
RECALL_GOOGLE_LOGIN_GROUP_ID=
