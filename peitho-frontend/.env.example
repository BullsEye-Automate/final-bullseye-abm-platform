# Proyecto de Supabase "peitho" (Project Settings → API) — el mismo que usa peitho-backend
# para DATABASE_URL, no el proyecto de bullseye-abm-platform.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL del backend de Peitho (peitho-backend). En local, el puerto donde corre `npm run dev` ahí.
PEITHO_BACKEND_URL=http://localhost:3001

# Misma URL que arriba, pero pública (visible en el navegador) — la usa
# DocumentUploadForm para subir archivos DIRECTO al backend en vez de pasar
# por una ruta proxy de Next.js, que en Vercel corta los archivos en 4.5MB
# (límite de las funciones serverless, no configurable en el plan Hobby).
# Requiere CORS habilitado en peitho-backend para este origen — ver
# PEITHO_FRONTEND_ORIGINS en peitho-backend/.env.example.
NEXT_PUBLIC_PEITHO_BACKEND_URL=http://localhost:3001
